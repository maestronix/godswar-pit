{
  "name": "godswar-pit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Godswar Pit - an idle roguelike for the browser. Climb to become a god.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "vite-node scripts/balance.ts",
    "gen:trees": "vite-node scripts/generate-trees.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-node": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
